[Unit]
Description=Generate operational health reports
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ops-reporter
WorkingDirectory=/opt/operations-automation-toolkit
ExecStart=/opt/operations-automation-toolkit/.venv/bin/opsctl fleet --inventory /etc/ops-toolkit/inventory.json --output /var/lib/ops-toolkit/fleet-health.md
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ops-toolkit

